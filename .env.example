# iWAAT Environment Configuration Template
# ==========================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# Supabase project credentials
# Get these from: https://supabase.com/dashboard/project/npqfnzuyglgrzsetrbdo/settings/api
VITE_SUPABASE_URL=https://npqfnzuyglgrzsetrbdo.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# Canonical public application URL (used for OAuth callback redirect)
# PRODUCTION value must be set in Vercel Environment Variables:
#   https://vercel.com/ujjwalmaurya2s-projects/iwaat/settings/environment-variables
# Set to: https://iwaat.vercel.app
# For local development: http://localhost:5173
VITE_APP_URL=https://iwaat.vercel.app
